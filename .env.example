# ---------------------------------------------------------------------------
# One Button Studio (by CARISCA): environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is git-ignored and must
# never be committed: it holds the keys that can move money.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# MySQL 8+ or MariaDB 10.6+. Create the database first, then run `npm run db:migrate`.
# Credentials are kept as separate fields, not a single connection string, so a
# password containing '@', ':' or '/' never needs URL-encoding.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="USER"
DB_PASSWORD="PASSWORD"
DB_NAME="carisca_studio"

# --- Application -----------------------------------------------------------
# Public base URL, no trailing slash. Used for links in emails and the Paystack callback.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secret used to sign/derive server-side session material.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- Paystack --------------------------------------------------------------
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use the sk_test_/pk_test_ pair until you are ready to take real money.
# PAYSTACK_SECRET_KEY is server-only and must NEVER be prefixed with NEXT_PUBLIC_.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Where Paystack sends the customer after checkout. Must match NEXT_PUBLIC_APP_URL.
PAYSTACK_CALLBACK_URL="http://localhost:3000/booking/callback"

# In the Paystack dashboard, set the webhook URL to:
#   <NEXT_PUBLIC_APP_URL>/api/payments/paystack/webhook
# Webhook authenticity is verified with PAYSTACK_SECRET_KEY, so there is no separate
# webhook secret to configure.

# --- Email -----------------------------------------------------------------
# SMTP connection string. Leave blank to disable sending; messages are then recorded
# in the dashboard and logged to the console instead of being delivered.
# Examples:
#   smtps://user:pass@smtp.gmail.com:465
#   smtp://resend:re_xxxxxxxx@smtp.resend.com:587
EMAIL_SERVER=""
EMAIL_FROM="One Button Studio <studio@carisca.org>"

# Where corporate enquiries and booking copies are sent.
ADMIN_EMAIL="studio@carisca.org"

# --- Seeding (optional) ----------------------------------------------------
# Used only by `npm run db:seed` when creating the first Super Admin.
# If ADMIN_PASSWORD is left blank, the seed generates a strong password and prints it once.
ADMIN_NAME="Studio Administrator"
ADMIN_PASSWORD=""

# --- Scheduled jobs (optional) ---------------------------------------------
# Shared secret for POST /api/cron: releases expired holds and sends reminders.
# Call it from your host's scheduler with the header:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""
