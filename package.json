    "lucide-react": "^1.47.0",
    "mariadb": "^3.5.4",
    "next": "16.3.5",
    "nodemailer": "^10.0.10",
    "prisma": "7.10.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
